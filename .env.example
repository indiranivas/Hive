# Copy to .env and fill in. Every value below is a default that already works
# offline -- nothing here is required to run Phase 1 locally.
#
# Stack policy: everything open source, except the LLM which runs on Azure
# OpenAI (data stays inside the tenant). NEVER put real keys in this file --
# it is committed. Real values go in .env, which is gitignored.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Database (open source: SQLite locally, PostgreSQL in Docker) --------------
# Local default is SQLite under backend/.data/. Docker Compose overrides this.
# DATABASE_URL=postgresql+psycopg://hive:password@postgres:5432/hive
AUTO_CREATE_SCHEMA=true
DB_PASSWORD=change-me

# --- Queue (open source: Redis + Celery) ---------------------------------------
REDIS_URL=redis://localhost:6379/0
INGEST_INTERVAL_MINUTES=10
INGEST_LOOKBACK_DAYS=30

# --- Vector store: sql | chroma (both open source) -----------------------------
# chroma = local persistent ChromaDB under backend/.data/chroma (no server
# needed; set CHROMA_URL to use a remote Chroma instead). sql = embeddings in
# the relational DB, zero extra dependencies.
VECTOR_PROVIDER=chroma
# CHROMA_URL=http://chromadb:8000

# --- Knowledge graph: memory | neo4j (both open source) -------------------------
# memory derives the graph from SQL on demand -- no service, always current.
# neo4j mirrors it into Neo4j (Community Edition or AuraDB) for Cypher access:
# POST /api/graph/sync after ingestion to refresh the mirror.
# NEO4J_URI schemes: bolt:// or neo4j+s:// use the Bolt driver (port 7687);
# https:// uses the Query API on 443 -- required where firewalls block Bolt.
# Real credentials go in .env, never here.
GRAPH_PROVIDER=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j


# --- Embeddings: hashing | sentence-transformers (both open source, no egress) -
# hashing is lexical and dependency-free (the offline default).
# sentence-transformers runs local models (`pip install -r requirements-ml.txt`).
# Set EMBEDDING_DIM to match the model:
#   all-MiniLM-L6-v2 = 384, bge-large-en-v1.5 = 1024.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- LLM: stub | azure_openai ---------------------------------------------------
# stub returns a cited evidence list with no synthesis and needs no key.
# azure_openai is the production choice -- the only non-open-source component.
LLM_PROVIDER=stub
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# --- Azure OpenAI Service (LLM_PROVIDER=azure_openai) ---------------------------
# Data stays inside the tenant, which is what the privacy section requires.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# DEPLOYMENT is the name you gave the deployment in the portal, not the model.
AZURE_OPENAI_DEPLOYMENT=
# Pin the api-version your resource supports.
AZURE_OPENAI_API_VERSION=2024-10-21
# key = api-key header (set AZURE_OPENAI_API_KEY below)
# entra = managed identity / az login via azure-identity, no stored secret
AZURE_OPENAI_AUTH=key
AZURE_OPENAI_API_KEY=
# auto sends max_completion_tokens for reasoning deployments (o-series, gpt-5)
# and max_tokens for everything else.
AZURE_OPENAI_TOKEN_PARAM=auto

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=15
RETRIEVAL_KR_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
# graded = LangGraph loop that grades retrieval and retries with a rewritten
# query before giving up. linear = single pass (the pre-graph behaviour).
RETRIEVAL_MODE=graded
RETRIEVAL_MAX_REWRITES=1
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_RATIO=0.2

# --- Auth: dev | azure_ad -----------------------------------------------------
AUTH_MODE=dev
DEV_USER_EMAIL=dev@levelshift.com
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Teams bot (Phase 2) ------------------------------------------------------
BOT_APP_ID=
BOT_APP_PASSWORD=

# --- Git sources (Phase 1) ----------------------------------------------------
# Comma-separated local clones -- the zero-credential path.
GIT_LOCAL_REPOS=
# Azure Repos: needs ADO_ORG, ADO_PROJECT, ADO_PAT (read-only scopes) and ADO_REPOS.
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
ADO_REPOS=
# GitHub: owner/name pairs.
GITHUB_TOKEN=
GITHUB_REPOS=

# --- Later phases -------------------------------------------------------------
HIVE_MAILBOX=hive@levelshift.com
WEBHOOK_SECRET=

# Every browser origin the dashboard may be served from. Add a port here if
# 3000 is taken and you start Next on another one, or fetches get CORS-blocked.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Dashboard ----------------------------------------------------------------
# The browser-reachable API URL. Compiled into the client bundle at build time.
PUBLIC_API_URL=http://localhost:8000