# Copy to .env and fill in. Every value below is a default that already works
# offline -- nothing here is required to run Phase 1 locally.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# Local default is SQLite under backend/.data/. Docker Compose overrides this.
# DATABASE_URL=postgresql+psycopg://hive:password@postgres:5432/hive
AUTO_CREATE_SCHEMA=true
DB_PASSWORD=change-me

# --- Queue --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
INGEST_INTERVAL_MINUTES=10
INGEST_LOOKBACK_DAYS=30

# --- Vector store: sql | chroma ----------------------------------------------
VECTOR_PROVIDER=sql
# CHROMA_URL=http://chromadb:8000

# --- Embeddings: hashing | azure_openai | sentence-transformers | mistral -----
# hashing is lexical and dependency-free (the offline default). azure_openai is
# the production choice. Set EMBEDDING_DIM to match the model:
#   text-embedding-3-small = 1536, text-embedding-3-large = 3072,
#   all-MiniLM-L6-v2 = 384, bge-large-en-v1.5 = 1024, mistral-embed = 1024.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- LLM: stub | azure_openai | mistral | anthropic ---------------------------
# stub returns a cited evidence list with no synthesis and needs no key.
LLM_PROVIDER=stub
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
# Only for the mistral / anthropic providers:
LLM_API_KEY=
LLM_MODEL=mistral-large-latest

# --- Azure OpenAI Service (LLM_PROVIDER / EMBEDDING_PROVIDER = azure_openai) --
# Data stays inside the tenant, which is what the privacy section requires.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# DEPLOYMENT is the name you gave the deployment in the portal, not the model.
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Pin the api-version your resource supports.
AZURE_OPENAI_API_VERSION=2024-10-21
# key = api-key header (set AZURE_OPENAI_API_KEY below)
# entra = managed identity / az login via azure-identity, no stored secret
AZURE_OPENAI_AUTH=key
AZURE_OPENAI_API_KEY=
# auto sends max_completion_tokens for reasoning deployments (o-series, gpt-5)
# and max_tokens for everything else.
AZURE_OPENAI_TOKEN_PARAM=auto
# Shorten v3 embedding vectors to EMBEDDING_DIM.
AZURE_OPENAI_SEND_DIMENSIONS=false

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=15
RETRIEVAL_KR_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
# graded = LangGraph loop that grades retrieval and retries with a rewritten
# query before giving up. linear = single pass (the pre-graph behaviour).
RETRIEVAL_MODE=graded
RETRIEVAL_MAX_REWRITES=1
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_RATIO=0.2

# --- Auth: dev | azure_ad -----------------------------------------------------
AUTH_MODE=dev
DEV_USER_EMAIL=dev@levelshift.com
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Teams bot (Phase 2) ------------------------------------------------------
BOT_APP_ID=
BOT_APP_PASSWORD=

# --- Git sources (Phase 1) ----------------------------------------------------
# Comma-separated local clones -- the zero-credential path.
GIT_LOCAL_REPOS=
# Azure Repos: needs ADO_ORG, ADO_PROJECT, ADO_PAT (read-only scopes) and ADO_REPOS.
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
ADO_REPOS=
# GitHub: owner/name pairs.
GITHUB_TOKEN=
GITHUB_REPOS=

# --- Later phases -------------------------------------------------------------
HIVE_MAILBOX=hive@levelshift.com
WEBHOOK_SECRET=

# Every browser origin the dashboard may be served from. Add a port here if
# 3000 is taken and you start Next on another one, or fetches get CORS-blocked.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Dashboard ----------------------------------------------------------------
# The browser-reachable API URL. Compiled into the client bundle at build time.
PUBLIC_API_URL=http://localhost:8000
